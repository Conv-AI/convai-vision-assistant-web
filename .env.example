# Copy this file to .env.local and add your API key. .env.local is ignored by git.
# Characters load automatically from your account; no character configuration is needed.
#
# The API key is read only by the server and is never sent to the browser.
# Do not use a VITE_ prefix: Vite exposes those values in browser code.

# Your Convai API key, from the Convai dashboard.
CONVAI_API_KEY=

# Optional: stable identity used for the character's long-term memory.
# All sessions use this identity. Defaults to vision-assistant-web-dev.
CONVAI_END_USER_ID=
